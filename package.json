{
  "name": "nexus",
  "version": "1.0.0",
  "description": "NEXUS — Agentic Venture Orchestration System",
  "private": true,
  "type": "module",
  "scripts": {
    "orchestrator": "node orchestrator/loop.js",
    "supervisor": "node scripts/supervisor.js",
    "dashboard": "cd dashboard && npm run dev",
    "careloop-api": "cd projects/careloop && npm run dev",
    "dev": "concurrently \"npm run supervisor\" \"npm run dashboard\" \"npm run careloop-api\"",
    "task": "node scripts/task.js",
    "agent": "node scripts/run-agent.js",
    "sprint": "node scripts/sprint.js",
    "skill": "node scripts/skill.js",
    "status": "node scripts/status.js",
    "reset": "node scripts/reset-memory.js",
    "check:model-routing": "node scripts/check-model-routing.js",
    "batch:submit": "node scripts/batch-submit.js",
    "batch:status": "node scripts/batch-status.js",
    "batch:poll:openai": "node scripts/batch-poll-openai.js",
    "batch:reconcile:openai": "node scripts/batch-reconcile-openai.js",
    "check:openai-batch": "node scripts/check-openai-batch.js",
    "check:contracts": "node scripts/check-contracts.js",
    "check:state-machine": "node scripts/check-state-machine.js",
    "check:agent-os-readiness": "node scripts/check-agent-os-readiness.js",
    "check:agent-context": "node scripts/check-agent-context.js",
    "check:data-protection": "node scripts/check-data-protection.js",
    "check:format-readability": "node scripts/check-format-readability.js",
    "check:security-boundary": "node scripts/check-security-boundary.js",
    "check:os-reliability": "node scripts/check-os-reliability.js",
    "check:capabilities": "node scripts/check-capabilities.js",
    "check:observability-evals-artifacts": "node scripts/check-observability-evals-artifacts.js"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.24.0",
    "chalk": "^5.3.0",
    "chokidar": "^3.6.0",
    "dotenv": "^16.4.5",
    "node-cron": "^3.0.3",
    "ollama": "^0.6.3",
    "openai": "^4.47.1",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  }
}
