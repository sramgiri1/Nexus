  "status": "in_progress",
  "scopeClassification": "NEXUS_OS_CHANGE",
  "objective": "Make the full Command Center accessible and founder-useful without enabling unsafe execution.",
  "safetyRules": [
    "No provider/model calls.",
    "No agent dispatch.",
    "No worker/tool execution.",
    "No project creation or mutation.",
    "No hosted DB mutation.",
    "No deploy, release, export, package creation, network calls, or provider spend.",
