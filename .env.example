# ── Providers ─────────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
OPENROUTER_API_KEY=

# ── Model IDs (resolve aliases in config/model-aliases.json) ──────────────────
# OpenAI models
OPENAI_CODE_MODEL=gpt-4o               # gpt-codex-latest alias
OPENAI_REASONING_MODEL=gpt-4o          # gpt-latest alias
OPENAI_CHEAP_MODEL=gpt-4o-mini         # gpt-mini-latest alias

# Anthropic models
ANTHROPIC_REASONING_MODEL=claude-sonnet-4-6        # claude-sonnet-latest alias
ANTHROPIC_CHEAP_MODEL=claude-haiku-4-5-20251001    # claude-haiku-latest alias

# ── Provider feature flags ────────────────────────────────────────────────────
ENABLE_OPENROUTER=true
ENABLE_DIRECT_BATCH=true
ENABLE_PROVIDER_FALLBACK=true
ENABLE_OLLAMA_FALLBACK=false

# ── Batch safety gates (keep false until check:model-routing passes) ──────────
ENABLE_REAL_OPENAI_BATCH=false
ENABLE_REAL_ANTHROPIC_BATCH=false
ENABLE_OPENROUTER_LIVE_SMOKE=false

# ── Per-agent provider/model overrides (optional) ─────────────────────────────
# <AGENT>_PROVIDER=openrouter    (e.g. NEXUS_PROVIDER, CORE_PROVIDER)
# <AGENT>_MODEL=claude-sonnet-4-6
# AGENT_MODEL=...                (global override for all agents)
# AGENT_PROVIDER=...             (global provider override)

# ── Orchestrator tuning ───────────────────────────────────────────────────────
LOOP_INTERVAL=10
MAX_TOKENS=2048

# ── Local model (Ollama) ──────────────────────────────────────────────────────
OLLAMA_HOST=http://localhost:11434
LOCAL_FAST_MODEL=qwen3:4b
LOCAL_CODE_MODEL=qwen2.5-coder:7b
LOCAL_MAX_ITER=3
LOCAL_MAX_PROMPT_TOKENS=8000
LOCAL_TIMEOUT_SECONDS=120

# ── Auto-heal / retry ─────────────────────────────────────────────────────────
MAX_AUTO_HEAL_ATTEMPTS=2
TASK_RETRY_DELAY_MS=15000

# ── Paths ─────────────────────────────────────────────────────────────────────
MEMORY_DIR=./memory
AGENTS_DIR=./agents
PROJECTS_DIR=./projects

# ── Optional integrations ─────────────────────────────────────────────────────
RAILWAY_TOKEN=
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
RESEND_API_KEY=
GITHUB_TOKEN=
