# ── Anthropic ─────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-your-key-here

# ── Orchestrator ───────────────────────────────────────────────────────
# How often the loop checks for pending tasks (seconds)
LOOP_INTERVAL=10

# Max tokens per agent call (keeps costs low)
MAX_TOKENS=2048

# Model for agents (use haiku for cheap, sonnet for quality)
AGENT_MODEL=claude-haiku-4-5-20251001

# Model for NEXUS orchestrator (needs more reasoning)
NEXUS_MODEL=claude-sonnet-4-6

# ── Paths ──────────────────────────────────────────────────────────────
MEMORY_DIR=./memory
AGENTS_DIR=./agents
PROJECTS_DIR=./projects

# ── Optional integrations ──────────────────────────────────────────────
RAILWAY_TOKEN=
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
RESEND_API_KEY=
GITHUB_TOKEN=
