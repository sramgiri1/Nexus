generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String
  phone        String?
  passwordHash String?
  pushToken    String?
  timezone     String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  identities    AuthIdentity[]
  memberships   CircleMember[]
  sentInvitations Invitation[] @relation("InvitationSender")
  acceptedInvitations Invitation[] @relation("InvitationResponder")
  passwordResetCodes PasswordResetCode[]
  tasksCreated  Task[]         @relation("TaskCreator")
  tasksAssigned Task[]         @relation("TaskAssignee")
  tasksCompleted Task[]        @relation("TaskCompletedBy")
  events        Event[]
  digestLogs    DigestLog[]
}

model AuthIdentity {
  id             String       @id @default(cuid())
  provider       AuthProvider
  providerUserId String
  providerEmail  String?
  providerName   String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId String

  @@unique([provider, providerUserId])
}

model PasswordResetCode {
  id         String   @id @default(cuid())
  codeHash   String
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime @default(now())

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId String
}

model CareCircle {
  id          String   @id @default(cuid())
  name        String
  recipientName String
  archiveAfterDays Int @default(7)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  members  CircleMember[]
  invitations Invitation[]
  recipients CareRecipient[]
  tasks    Task[]
  events   Event[]
}

model Invitation {
  id         String           @id @default(cuid())
  email      String
  name       String
  role       Role             @default(MEMBER)
  status     InvitationStatus @default(PENDING)
  acceptedAt DateTime?
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt

  circle   CareCircle @relation(fields: [circleId], references: [id], onDelete: Cascade)
  circleId String

  invitedBy   User?   @relation("InvitationSender", fields: [invitedById], references: [id], onDelete: SetNull)
  invitedById String?

  acceptedBy   User?   @relation("InvitationResponder", fields: [acceptedById], references: [id], onDelete: SetNull)
  acceptedById String?
}

model CareRecipient {
  id           String   @id @default(cuid())
  name         String
  relationship String?
  notes        String?
  isPrimary    Boolean  @default(false)
  sortOrder    Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  circle   CareCircle @relation(fields: [circleId], references: [id], onDelete: Cascade)
  circleId String

  tasks Task[]
}

model CircleMember {
  id       String   @id @default(cuid())
  role     Role     @default(MEMBER)
  joinedAt DateTime @default(now())

  user     User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId   String
  circle   CareCircle @relation(fields: [circleId], references: [id], onDelete: Cascade)
  circleId String

  @@unique([userId, circleId])
}

model Task {
  id          String     @id @default(cuid())
  title       String
  notes       String?
  dueAt       DateTime?
  status      TaskStatus @default(PENDING)
  priority    Priority   @default(NORMAL)
  recurrenceFrequency RecurrenceFrequency @default(NONE)
  recurrenceInterval Int?
  recurrenceWeekdays String[] @default([])
  recurrenceEndsAt DateTime?
  seriesId     String?
  completedAt DateTime?
  archivedAt  DateTime?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  circle      CareCircle @relation(fields: [circleId], references: [id], onDelete: Cascade)
  circleId    String
  recipient   CareRecipient? @relation(fields: [recipientId], references: [id], onDelete: SetNull)
  recipientId String?
  creator     User       @relation("TaskCreator", fields: [creatorId], references: [id])
  creatorId   String
  assignee    User?      @relation("TaskAssignee", fields: [assigneeId], references: [id])
  assigneeId  String?
  completedBy User?      @relation("TaskCompletedBy", fields: [completedById], references: [id])
  completedById String?

  reminders   Reminder[]
}

model Reminder {
  id          String         @id @default(cuid())
  scheduledAt DateTime
  sentAt      DateTime?
  channel     Channel        @default(PUSH)
  status      ReminderStatus @default(PENDING)
  escalatedAt DateTime?

  task   Task   @relation(fields: [taskId], references: [id], onDelete: Cascade)
  taskId String
}

model Event {
  id        String    @id @default(cuid())
  type      EventType
  payload   Json      @default("{}")
  createdAt DateTime  @default(now())

  circle   CareCircle @relation(fields: [circleId], references: [id], onDelete: Cascade)
  circleId String
  actor    User?      @relation(fields: [actorId], references: [id])
  actorId  String?
}

model DigestLog {
  id        String   @id @default(cuid())
  date      String
  messageId String?
  createdAt DateTime @default(now())

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId String

  @@unique([userId, date])
}

enum Role {
  ADMIN
  MEMBER
}

enum TaskStatus {
  PENDING
  IN_PROGRESS
  DONE
  SKIPPED
}

enum Priority {
  LOW
  NORMAL
  HIGH
  URGENT
}

enum RecurrenceFrequency {
  NONE
  DAILY
  WEEKLY
  MONTHLY
  CUSTOM
}

enum Channel {
  PUSH
  EMAIL
  SMS
}

enum ReminderStatus {
  PENDING
  SENT
  FAILED
  ESCALATED
}

enum EventType {
  CIRCLE_CREATED
  INVITE_CREATED
  INVITE_ACCEPTED
  INVITE_DECLINED
  INVITE_REVOKED
  RECIPIENT_ADDED
  RECIPIENT_UPDATED
  RECIPIENT_REMOVED
  TASK_CREATED
  TASK_SERIES_CREATED
  TASK_UPDATED
  TASK_COMPLETED
  TASK_DELETED
  MEMBER_JOINED
  MEMBER_REMOVED
  MEMBER_ROLE_UPDATED
  REMINDER_SENT
  REMINDER_ESCALATED
  DIGEST_SENT
  DIGEST_OPENED
  APP_SESSION
}

enum AuthProvider {
  GOOGLE
  FACEBOOK
  APPLE
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  DECLINED
  REVOKED
}
