  "purpose": "merge_gate_rollback_branch_model",
  "metadataOnly": true,
  "mergeAllowed": false,
  "pushAllowed": false,
  "releaseAllowed": false,
  "packageCreationAllowed": false,
  "rollbackBranchCreationAllowed": false,
