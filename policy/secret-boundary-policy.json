{
  "version": "1.0",
  "rawSecretExposure": "deny",
  "allowedSecretOperations": [
    "secret_existence_check",
    "secret_metadata_check",
    "secret_reference_by_name",
    "secret_rotation_plan",
    "secret_access_request"
  ],
  "blockedSecretOperations": [
    "print_secret",
    "echo_env",
    "log_secret",
    "send_to_llm",
    "send_to_batch",
    "send_to_openrouter",
    "put_in_evidence",
    "commit_secret",
    "copy_to_report",
    "copy_to_ui"
  ],
  "scanBefore": [
    "model_context",
    "batch_queue",
    "log_write",
    "evidence_persist",
    "git_commit",
    "ui_response"
  ],
  "secretPatternsReference": "security/pii-patterns.json"
}
